# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env de verdade (ele já está no .gitignore).

# --- Obrigatórias (config.validar_configuracao() falha se faltar alguma) ---
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REFRESH_TOKEN=
GEMINI_API_KEY=

# A qual conta da Conta Azul as credenciais acima apontam - "teste" ou
# "producao", exatamente (sem valor padrão de propósito). Existe porque já
# aconteceu de verdade: lançamentos financeiros duplicados criados durante
# testes sem ninguém ter certeza visual de qual conta estava em uso. O
# monitor_pasta.py loga isso bem chamativo ao iniciar, e o painel mostra
# uma faixa colorida fixa no topo - confira sempre antes de aprovar algo.
CONTA_AZUL_AMBIENTE=

# --- Opcionais (valores padrão usados se não definidas) ---
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-3.6-flash
CONTA_FINANCEIRA_ID_PADRAO=
HTTP_TIMEOUT_SEGUNDOS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.5
PASTA_ENTRADA=entrada
PASTA_PROCESSADOS=processados
PASTA_REVISAO=revisao
PASTA_DESCARTADOS=descartados
ENV_FILE_PATH=.env
REGISTRO_FORNECEDORES_PATH=fornecedores_registry.json

# Login Microsoft 365 dentro do painel (opcional). Com as três primeiras
# preenchidas, o painel exige login. Valores do registro do app no Entra ID:
# "ID do aplicativo (cliente)", "ID do diretório (locatário)" e o VALOR do
# segredo do cliente (não o "ID do segredo"). No registro do app, cadastre
# como URI de redirecionamento (plataforma Web) o endereço do painel +
# /auth/callback - ex: http://localhost:8000/auth/callback
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
# Só se o endereço público for diferente do que o painel enxerga (proxy):
MS_REDIRECT_URI=
# E-mails liberados, separados por vírgula (vazio = qualquer conta da empresa):
USUARIOS_PERMITIDOS=
# Chave longa e aleatória que assina o cookie de sessão (vazio = gera uma
# nova a cada reinício e todos precisam entrar de novo):
SESSAO_CHAVE=

# Google Cloud Run (opcional): ID do projeto cujo Secret Manager guarda os
# segredos (mesmos nomes do Key Vault + ms-client-secret e sessao-chave).
GOOGLE_SECRET_MANAGER_PROJETO=
# Pasta local das travas de arquivo, quando os dados ficam num bucket (no
# Dockerfile já vem /tmp/travas). Vazia = trava ao lado do arquivo.
PASTA_TRAVAS=

# secrets.toml - credenciais e configurações do Agente Conta Azul
#
# NUNCA vai para o git nem para a imagem Docker (está no .gitignore e no
# .dockerignore). Lido ANTES do .env e com prioridade sobre ele: o que estiver
# preenchido aqui vale; o que estiver vazio ("") é completado pelo .env.
# As seções [..] são só organização - cada chave vira a variável de mesmo nome.
#
# O CONTA_AZUL_REFRESH_TOKEN muda a cada renovação: se ele estiver preenchido
# aqui, o painel grava o token novo NESTE arquivo automaticamente. Não copie
# este arquivo para outro PC com o mesmo token (um derruba o outro).

[conta_azul]
# "teste" ou "producao" - o selo no topo do painel mostra qual está valendo.
CONTA_AZUL_AMBIENTE = ""
CONTA_AZUL_CLIENT_ID = ""
CONTA_AZUL_CLIENT_SECRET = ""
CONTA_AZUL_REFRESH_TOKEN = ""

[gemini]
GEMINI_API_KEY = ""
GEMINI_MODEL = ""

[microsoft]
# Login Microsoft 365 no painel (registro do app no Entra ID). Com os três
# primeiros preenchidos, o painel passa a exigir login.
MS_CLIENT_ID = ""        # ID do aplicativo (cliente)
MS_TENANT_ID = ""        # ID do diretório (locatário)
MS_CLIENT_SECRET = ""    # o VALOR do segredo (não o "ID do segredo")
MS_REDIRECT_URI = ""     # só se o endereço público for diferente do que o painel enxerga
USUARIOS_PERMITIDOS = "" # e-mails separados por vírgula; vazio = qualquer conta da empresa
SESSAO_CHAVE = ""        # texto longo e aleatório que assina o cookie de sessão

[google]
# ID do projeto cujo Secret Manager guarda os segredos (Cloud Run).
GOOGLE_SECRET_MANAGER_PROJETO = ""

[azure]
# Endereço do Key Vault (Container Apps), ex.: https://seu-keyvault.vault.azure.net/
AZURE_KEY_VAULT_URL = ""
